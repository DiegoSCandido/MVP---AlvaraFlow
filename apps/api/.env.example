# Banco local em arquivo — nenhum servico externo necessario.
DATABASE_URL="file:./alvaraflow.db"

PORT=3333
NODE_ENV=development

# Troque por um segredo longo e aleatorio em producao.
JWT_SECRET="dev-secret-troque-em-producao"
JWT_EXPIRES_IN="8h"

# Origem do frontend autorizada no CORS (lista separada por virgula).
CORS_ORIGIN="http://localhost:5173"

# Pasta onde os anexos sao gravados.
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10
